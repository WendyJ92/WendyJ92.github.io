        </mxCell>
        <mxCell id="CRM_AsIs_Swimlane_EN_a4" value="&amp;lt;b&amp;gt;04  Stock dispatch&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Movement recorded separately&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEEEF;strokeColor=#DF9EA2;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
