        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_foot" value="PERIODIC COUNT     Opening stock + received + transfers in - sales - approved gifts - transfers out + approved returns / adjustments" style="rounded=1;arcSize=5;whiteSpace=wrap;fillColor=#EDF5FC;strokeColor=#C5DCEF;fontColor=#246AA3;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
