        </mxCell>
        <mxCell id="CRM_AsIs_Swimlane_EN_a5" value="&amp;lt;b&amp;gt;05  Delivery follow-up&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Receipt / stock owner not always reconciled promptly&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEEEF;strokeColor=#DF9EA2;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1540" y="466" width="340" height="166" as="geometry" />
        </mxCell>
        <mxCell id="CRM_AsIs_Swimlane_EN_a6" value="&amp;lt;b&amp;gt;06  Cash handover&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Cash record may need separate confirmation&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEEEF;strokeColor=#DF9EA2;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
