        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c3" value="&amp;lt;b&amp;gt;03  Check receipt&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Receiver confirms physical SKU and quantity&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C9D8;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
