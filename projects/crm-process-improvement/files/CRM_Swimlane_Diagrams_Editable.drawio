        <mxCell id="CRM_ToBe_OrderToCash_Swimlane_EN_b7" value="&amp;lt;b&amp;gt;07  Finance check&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Confirm posted funds or establish approved SD receivable&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#98D4C6;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
