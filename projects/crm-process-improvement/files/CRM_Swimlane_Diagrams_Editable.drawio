        </mxCell>
        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c5" value="&amp;lt;b&amp;gt;05  Customer sale&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Deduct sales stock on order; never count dispatch as a sale&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF5FC;strokeColor=#A8CBE8;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2220" y="811" width="350" height="166" as="geometry" />
        </mxCell>
        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c6" value="&amp;lt;b&amp;gt;Mismatch / adjustment&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Open an issue with reason and evidence&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEEEF;strokeColor=#E2A6A6;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
