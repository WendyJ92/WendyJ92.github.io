        <mxCell id="CRM_ToBe_OrderToCash_Swimlane_EN_b8" value="&amp;lt;b&amp;gt;08  Flag exceptions&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Keep discrepancies open until reviewed&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEEEF;strokeColor=#E2A6A6;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1990" y="609" width="280" height="166" as="geometry" />
        </mxCell>
        <mxCell id="CRM_ToBe_OrderToCash_Swimlane_EN_b8a" value="&amp;lt;b&amp;gt;Review / approve&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Authorised resolution with reason and history&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3E2;strokeColor=#DDB681;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
