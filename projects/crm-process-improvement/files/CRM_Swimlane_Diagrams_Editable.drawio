        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c1" value="&amp;lt;b&amp;gt;01  Create dispatch&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Source stock, recipient, SKU, flavour and quantity&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C9D8;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="291" width="325" height="166" as="geometry" />
        </mxCell>
        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c2" value="&amp;lt;b&amp;gt;02  Release / in transit&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Record date, documents and status&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C9D8;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="291" width="325" height="166" as="geometry" />
