        </mxCell>
        <mxCell id="CRM_ToBe_StockControl_Swimlane_EN_c4" value="&amp;lt;b&amp;gt;04  Transfer stock&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Update warehouse -&amp;amp;gt; region / salesperson stock&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF5FC;strokeColor=#A8CBE8;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
