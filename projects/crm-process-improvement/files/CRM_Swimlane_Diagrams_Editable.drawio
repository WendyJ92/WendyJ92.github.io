        </mxCell>
        <mxCell id="CRM_ToBe_OrderToCash_Swimlane_EN_foot" value="CLOSE GATE     Complete fields  +  accurate stock  +  confirmed payment or valid SD terms  +  approved exceptions" style="rounded=1;arcSize=5;whiteSpace=wrap;fillColor=#EDF5FC;strokeColor=#C5DCEF;fontColor=#246AA3;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
