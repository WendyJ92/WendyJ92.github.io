        <mxCell id="CRM_ToBe_OrderToCash_Swimlane_EN_b5sd" value="&amp;lt;b&amp;gt;05B  SD credit approval&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#586D84&amp;quot; style=&amp;quot;font-size:15px&amp;quot;&amp;gt;Valid credit terms and due date; only SD eligible&amp;lt;/font&amp;gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3E2;strokeColor=#DDB681;strokeWidth=2;fontSize=18;fontColor=#14273E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
